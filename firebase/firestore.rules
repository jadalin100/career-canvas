rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function pilotClass(classId) { return classId == "career-canvas-pilot"; }
    function teacher() {
      return signedIn() && request.auth.token.email == "careercanva.gns@gmail.com";
    }

    match /classes/{classId}/students/{studentId} {
      allow create: if pilotClass(classId) && signedIn()
        && request.resource.data.authUid == request.auth.uid
        && !exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId));
      allow get: if pilotClass(classId) && (teacher() || (signedIn()
        && (!exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId))
          || resource.data.authUid == request.auth.uid)));
      allow list: if pilotClass(classId) && teacher();
      allow update: if pilotClass(classId) && (teacher() || (signedIn()
        && resource.data.authUid == request.auth.uid
        && request.resource.data.authUid == request.auth.uid));
      allow delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/quizzes/{quizId} {
      allow read: if pilotClass(classId) && (teacher()
        || (signedIn() && resource.data.status == "published")
        || (signedIn() && resource.data.authUid == request.auth.uid));
      allow create: if pilotClass(classId) && signedIn()
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if pilotClass(classId) && (teacher()
        || (signedIn()
          && resource.data.authUid == request.auth.uid
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.status == "pending"));
      allow delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/attempts/{attemptId} {
      allow create: if pilotClass(classId) && signedIn() && request.resource.data.authUid == request.auth.uid;
      allow read: if pilotClass(classId) && (teacher() || (signedIn() && resource.data.authUid == request.auth.uid));
      allow update, delete: if false;
    }
  }
}
