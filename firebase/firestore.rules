rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Add each approved class ID here when a new class is created.
    function pilotClass(classId) { return classId in ["career-canvas-pilot"]; }
    function teacher() {
      return signedIn() && request.auth.token.email in [
        "careercanva.gns@gmail.com",
        "jadaxinyulin@gmail.com",
        "jlin15@student.gn.k12.ny.us"
      ];
    }
    function activeStudent(classId, studentId) {
      return signedIn()
        && !exists(/databases/$(database)/documents/classes/$(classId)/blockedStudents/$(studentId))
        && exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId))
        && get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)).data.authUid == request.auth.uid;
    }

    match /classes/{classId}/blockedStudents/{studentId} {
      allow get: if pilotClass(classId) && signedIn();
      allow list, create, update, delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/students/{studentId} {
      allow create: if pilotClass(classId) && signedIn()
        && request.resource.data.authUid == request.auth.uid
        && !exists(/databases/$(database)/documents/classes/$(classId)/blockedStudents/$(studentId))
        && !exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId));
      // Unlocked names can be reclaimed by anyone with the class code (e.g. after an iPad tab reset);
      // the teacher can lock a name to its current device.
      allow get: if pilotClass(classId) && (teacher()
        || activeStudent(classId, studentId)
        || (signedIn() && !exists(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)))
        || (signedIn() && get(/databases/$(database)/documents/classes/$(classId)/students/$(studentId)).data.get("locked", false) != true));
      allow list: if pilotClass(classId) && teacher();
      allow update: if pilotClass(classId) && (teacher()
        || (signedIn() && !exists(/databases/$(database)/documents/classes/$(classId)/blockedStudents/$(studentId))
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.get("locked", false) == resource.data.get("locked", false)
          && (activeStudent(classId, studentId) || resource.data.get("locked", false) != true)));
      allow delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/quizzes/{quizId} {
      allow read: if pilotClass(classId) && (teacher()
        || (signedIn() && resource.data.status == "published")
        || activeStudent(classId, resource.data.ownerId));
      allow create: if pilotClass(classId) && activeStudent(classId, request.resource.data.ownerId)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if pilotClass(classId) && (teacher()
        || (activeStudent(classId, resource.data.ownerId)
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == "pending"));
      allow delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/attempts/{attemptId} {
      allow create: if pilotClass(classId) && activeStudent(classId, request.resource.data.playerId)
        && request.resource.data.authUid == request.auth.uid;
      allow read: if pilotClass(classId) && (teacher() || (signedIn() && resource.data.authUid == request.auth.uid));
      // Permit an exact no-op retry so an offline attempt can safely finish syncing
      // if the first write reached Firestore but the acknowledgement was lost.
      allow update: if pilotClass(classId)
        && activeStudent(classId, resource.data.playerId)
        && resource.data.authUid == request.auth.uid
        && request.resource.data == resource.data;
      allow delete: if pilotClass(classId) && teacher();
    }

    match /classes/{classId}/artifacts/{artifactId} {
      allow read: if pilotClass(classId) && (teacher()
        || (signedIn() && resource.data.status == "published")
        || activeStudent(classId, resource.data.ownerId));
      allow create: if pilotClass(classId) && activeStudent(classId, request.resource.data.ownerId)
        && request.resource.data.authUid == request.auth.uid
        && request.resource.data.status == "pending";
      allow update: if pilotClass(classId) && (teacher()
        || (activeStudent(classId, resource.data.ownerId)
          && request.resource.data.authUid == request.auth.uid
          && request.resource.data.ownerId == resource.data.ownerId
          && request.resource.data.status == "pending"));
      allow delete: if pilotClass(classId) && teacher();
    }
  }
}
